// The Details tab of the executable's Properties in Explorer. build.rs
// writes version.h into OUT_DIR with the version and this exe's names.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     TT_VERSION_NUMBERS
PRODUCTVERSION  TT_VERSION_NUMBERS
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       TT_FILE_FLAGS
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // U.S. English, Unicode.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "ThirtyTech"
            VALUE "FileDescription",  TT_FILE_DESCRIPTION
            VALUE "FileVersion",      TT_VERSION
            VALUE "InternalName",     TT_INTERNAL_NAME
            VALUE "LegalCopyright",   "Copyright (c) ThirtyTech. MIT License."
            VALUE "OriginalFilename", TT_ORIGINAL_FILENAME
            VALUE "ProductName",      "tt-git"
            VALUE "ProductVersion",   TT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
