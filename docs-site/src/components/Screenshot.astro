---
// A screenshot from src/assets/screens/: an annotated `.webp` made by
// `pnpm screens`, or a `gui-*.png` captured from the desktop app's window.
// The image is served as rendered (no re-encoding), so text stays crisp;
// clicking it opens it full size.
import type { ImageMetadata } from 'astro';

interface Props {
	/** File name in src/assets/screens/, without `.webp` or `.png`. */
	name: string;
	alt: string;
	caption?: string;
}

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.{webp,png}', { eager: true });
const { name, alt, caption } = Astro.props;
const image = (images[`../assets/screens/${name}.webp`] ?? images[`../assets/screens/${name}.png`])?.default;
if (!image) throw new Error(`No screenshot named "${name}" in src/assets/screens/`);
---

<figure class="screenshot not-content">
	<a href={image.src} target="_blank" rel="noopener" aria-label={`${alt} (open full size)`}>
		<img src={image.src} width={image.width} height={image.height} alt={alt} loading="lazy" decoding="async" />
	</a>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.screenshot {
		margin-block: 1.5rem;
	}
	.screenshot a {
		display: block;
		border-radius: 0.6rem;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--tt-cyan) 30%, var(--sl-color-gray-5));
		box-shadow: 0 0.75rem 2rem -1rem rgb(0 0 0 / 0.6);
		transition: border-color 0.15s;
	}
	.screenshot a:hover {
		border-color: var(--tt-cyan);
	}
	.screenshot img {
		display: block;
		width: 100%;
		height: auto;
	}
	.screenshot figcaption {
		margin-top: 0.5rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		text-align: center;
	}
</style>
