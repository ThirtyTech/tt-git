---
// The homepage's moving background, after the backdrop in the video: thin
// commit lanes running down the page and soft glows, with pulses climbing the
// lanes. A pulse lights each commit it passes and sometimes hops to the next
// lane, drawing a merge line as it goes. The lanes are drawn on a canvas so
// they follow the theme and stay sharp at any width.
//
// With reduced motion on, the lanes are drawn once and nothing moves. The
// styles below also animate the hero and the cards. Astro bundles them into
// the CSS every docs page loads, so those rules are scoped to the hero page.
---

<div class="commit-backdrop not-content" aria-hidden="true">
	<canvas></canvas>
</div>

<script>
	interface Lane {
		x: number;
		sway: number;
		wavelength: number;
		phase: number;
		gap: number;
		offset: number;
		color: number;
		fade: number;
	}

	interface Hop {
		from: Lane;
		to: Lane;
		startY: number;
		endY: number;
		color: string;
		born: number;
	}

	interface Pulse {
		lane: Lane;
		y: number;
		speed: number;
		color: string;
		nextCommit: number;
		hop?: Hop;
		trail: { x: number; y: number }[];
	}

	interface Ring {
		x: number;
		y: number;
		color: string;
		born: number;
	}

	// The graph's lane colors. Light mode darkens them to hold up on white.
	const THEMES = {
		dark: {
			background: '#0d1016',
			lanes: ['#4bc0eb', '#7bd938', '#d16ba5', '#e5b567', '#929291', '#9d8cf2'],
			laneAlpha: 0.3,
		},
		light: {
			background: '#ffffff',
			lanes: ['#006698', '#3f8f12', '#b03a7a', '#a8741a', '#85898f', '#6a4fc8'],
			laneAlpha: 0.24,
		},
	};

	const LANE_SPACING = 170;
	const HOP_CHANCE = 0.3;
	const HOP_HEIGHT = 150;
	const HOP_LIFETIME = 4;
	const RING_LIFETIME = 1.4;
	const TRAIL_LENGTH = 170;
	const PARALLAX = 0.25;

	const canvas = document.querySelector<HTMLCanvasElement>('.commit-backdrop canvas')!;
	const context = canvas.getContext('2d')!;
	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

	let width = 0;
	let height = 0;
	let lanes: Lane[] = [];
	let pulses: Pulse[] = [];
	let hops: Hop[] = [];
	let rings: Ring[] = [];
	let frame = 0;
	let lastFrame = 0;
	let time = 0;

	const random = (min: number, max: number) => min + Math.random() * (max - min);
	const smoothstep = (t: number) => t * t * (3 - 2 * t);
	const theme = () => THEMES[document.documentElement.dataset.theme === 'light' ? 'light' : 'dark'];
	const scrollOffset = () => (reducedMotion.matches ? 0 : window.scrollY * PARALLAX);

	// The third harmonic flattens the wave's peaks, so a lane runs straight
	// for a while and then bends, like a lane in the graph.
	function laneX(lane: Lane, y: number) {
		const u = y / lane.wavelength + lane.phase + time * 0.03;
		return lane.x + lane.sway * (Math.sin(u) + Math.sin(3 * u) / 3);
	}

	function hopX(hop: Hop, y: number) {
		const t = (hop.startY - y) / (hop.startY - hop.endY);
		const from = laneX(hop.from, y);
		return from + (laneX(hop.to, y) - from) * smoothstep(Math.min(Math.max(t, 0), 1));
	}

	function commitAbove(lane: Lane, y: number) {
		return Math.ceil((y - lane.offset) / lane.gap - 1) * lane.gap + lane.offset;
	}

	function spawn(pulse: Partial<Pulse> = {}): Pulse {
		const lane = lanes[Math.floor(random(0, lanes.length))];
		const y = scrollOffset() + height + random(0, height);
		return {
			lane,
			y,
			speed: random(110, 190),
			color: theme().lanes[lane.color],
			nextCommit: commitAbove(lane, y),
			trail: [],
			...pulse,
		};
	}

	// Lanes keep their places when only the height changes, as it does when
	// a phone's address bar slides away.
	function resize() {
		const ratio = Math.min(window.devicePixelRatio, 2);
		const widthChanged = window.innerWidth !== width;
		width = window.innerWidth;
		height = window.innerHeight;
		canvas.width = width * ratio;
		canvas.height = height * ratio;
		context.setTransform(ratio, 0, 0, ratio, 0, 0);
		if (!widthChanged) return;

		const count = Math.max(Math.round(width / LANE_SPACING), 3);
		const column = Math.min(width / 2, 400);
		lanes = Array.from({ length: count }, (_, i) => {
			const x = ((i + 0.5) / count) * width + random(-20, 20);
			return {
				x,
				sway: random(12, 26),
				wavelength: random(70, 130),
				phase: random(0, Math.PI * 2),
				gap: random(170, 320),
				offset: random(0, 300),
				color: i % THEMES.dark.lanes.length,
				// Keep the lanes behind the text column quiet.
				fade: 0.45 + 0.55 * Math.min(Math.abs(x - width / 2) / column, 1),
			};
		});
		pulses = Array.from({ length: Math.ceil(count / 2) + 1 }, () => spawn());
		hops = [];
		rings = [];
	}

	function advance(pulse: Pulse, delta: number, offset: number) {
		pulse.y -= pulse.speed * delta;

		if (pulse.hop && pulse.y <= pulse.hop.endY) {
			pulse.lane = pulse.hop.to;
			pulse.hop = undefined;
			pulse.nextCommit = commitAbove(pulse.lane, pulse.y);
			rings.push({ x: laneX(pulse.lane, pulse.y), y: pulse.y, color: pulse.color, born: time });
		}

		if (!pulse.hop && pulse.y <= pulse.nextCommit) {
			const y = pulse.nextCommit;
			pulse.nextCommit -= pulse.lane.gap;
			rings.push({ x: laneX(pulse.lane, y), y, color: pulse.color, born: time });

			const index = lanes.indexOf(pulse.lane);
			const neighbor = lanes[index + (Math.random() < 0.5 ? -1 : 1)];
			if (neighbor && Math.random() < HOP_CHANCE) {
				const hop = { from: pulse.lane, to: neighbor, startY: y, endY: y - HOP_HEIGHT, color: pulse.color, born: time };
				pulse.hop = hop;
				hops.push(hop);
			}
		}

		const x = pulse.hop ? hopX(pulse.hop, pulse.y) : laneX(pulse.lane, pulse.y);
		pulse.trail.push({ x, y: pulse.y });
		while (pulse.trail[0].y - pulse.y > TRAIL_LENGTH) pulse.trail.shift();

		// Off the top, or left far behind by a jump in the scroll position.
		const gone = pulse.y < offset - TRAIL_LENGTH || pulse.y > offset + height * 3;
		return gone ? spawn({ y: offset + height + random(0, height * 0.75) }) : pulse;
	}

	function drawLanes(offset: number) {
		const { background, lanes: colors, laneAlpha } = theme();
		context.lineWidth = 1.25;
		context.lineCap = 'round';

		for (const lane of lanes) {
			context.strokeStyle = colors[lane.color];
			context.globalAlpha = laneAlpha * lane.fade;
			context.beginPath();
			for (let y = -12; y <= height + 12; y += 8) {
				context.lineTo(laneX(lane, y + offset), y);
			}
			context.stroke();

			// Commits: a small ring that breaks the line.
			const first = Math.ceil((offset - lane.offset) / lane.gap);
			for (let k = first; k * lane.gap + lane.offset - offset <= height + 6; k++) {
				const y = k * lane.gap + lane.offset;
				context.beginPath();
				context.arc(laneX(lane, y), y - offset, 3, 0, Math.PI * 2);
				context.globalAlpha = 1;
				context.fillStyle = background;
				context.fill();
				context.globalAlpha = Math.min(laneAlpha * 2.2, 1) * lane.fade;
				context.stroke();
			}
		}
	}

	function drawHops(offset: number) {
		hops = hops.filter((hop) => time - hop.born < HOP_LIFETIME);
		context.lineWidth = 1.25;
		for (const hop of hops) {
			const age = (time - hop.born) / HOP_LIFETIME;
			context.strokeStyle = hop.color;
			context.globalAlpha = 0.5 * (1 - age);
			context.beginPath();
			for (let y = hop.startY; y >= hop.endY; y -= 6) {
				context.lineTo(hopX(hop, y), y - offset);
			}
			context.stroke();
		}
	}

	function drawRings(offset: number) {
		rings = rings.filter((ring) => time - ring.born < RING_LIFETIME);
		context.lineWidth = 1.5;
		for (const ring of rings) {
			const age = (time - ring.born) / RING_LIFETIME;
			context.strokeStyle = ring.color;
			context.fillStyle = ring.color;
			context.globalAlpha = 0.8 * (1 - age);
			context.beginPath();
			context.arc(ring.x, ring.y - offset, 3 + 22 * smoothstep(age), 0, Math.PI * 2);
			context.stroke();
			context.beginPath();
			context.arc(ring.x, ring.y - offset, 3, 0, Math.PI * 2);
			context.fill();
		}
	}

	function drawPulses(offset: number) {
		context.lineWidth = 2;
		for (const { trail, color, lane } of pulses) {
			const head = trail.at(-1);
			if (!head) continue;
			const tail = trail[0];
			const headY = head.y - offset;

			const fade = context.createLinearGradient(0, tail.y - offset, 0, headY);
			fade.addColorStop(0, `${color}00`);
			fade.addColorStop(1, color);
			context.strokeStyle = fade;
			context.globalAlpha = 0.5 + 0.5 * lane.fade;
			context.beginPath();
			for (const point of trail) context.lineTo(point.x, point.y - offset);
			context.stroke();

			const glow = context.createRadialGradient(head.x, headY, 0, head.x, headY, 16);
			glow.addColorStop(0, `${color}cc`);
			glow.addColorStop(0.25, `${color}55`);
			glow.addColorStop(1, `${color}00`);
			context.fillStyle = glow;
			context.fillRect(head.x - 16, headY - 16, 32, 32);
		}
	}

	function draw() {
		const offset = scrollOffset();
		context.clearRect(0, 0, width, height);
		drawLanes(offset);
		drawHops(offset);
		drawRings(offset);
		drawPulses(offset);
		context.globalAlpha = 1;
	}

	function tick(now: number) {
		// A long gap means the tab was busy. Pulses shouldn't jump across it.
		const delta = Math.min((now - lastFrame) / 1000, 0.05);
		lastFrame = now;
		time += delta;
		const offset = scrollOffset();
		pulses = pulses.map((pulse) => advance(pulse, delta, offset));
		draw();
		frame = requestAnimationFrame(tick);
	}

	function restart() {
		cancelAnimationFrame(frame);
		if (reducedMotion.matches) {
			pulses = [];
			hops = [];
			rings = [];
			draw();
		} else if (!document.hidden) {
			if (!pulses.length) pulses = Array.from({ length: Math.ceil(lanes.length / 2) + 1 }, () => spawn());
			lastFrame = performance.now();
			frame = requestAnimationFrame(tick);
		}
	}

	function recolor() {
		const { lanes: colors } = theme();
		pulses = pulses.map((pulse) => ({ ...pulse, color: colors[pulse.lane.color] }));
		hops = [];
		rings = [];
		if (reducedMotion.matches) draw();
	}

	window.addEventListener('resize', () => {
		resize();
		restart();
	});
	document.addEventListener('visibilitychange', restart);
	reducedMotion.addEventListener('change', restart);
	new MutationObserver(recolor).observe(document.documentElement, { attributeFilter: ['data-theme'] });

	resize();
	restart();
</script>

<style is:global>
	.commit-backdrop {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
	}
	.commit-backdrop canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
	/* The soft glows behind the lanes: green on the left, cyan on the right. */
	.commit-backdrop::before,
	.commit-backdrop::after {
		content: '';
		position: absolute;
		width: 70vmax;
		aspect-ratio: 1;
		border-radius: 50%;
	}
	.commit-backdrop::before {
		inset: 5% auto auto -30vmax;
		background: radial-gradient(closest-side, color-mix(in srgb, var(--tt-green) 12%, transparent), transparent);
	}
	.commit-backdrop::after {
		inset: auto -25vmax -20vmax auto;
		background: radial-gradient(closest-side, color-mix(in srgb, var(--tt-cyan) 18%, transparent), transparent);
	}

	/* The link cards are see-through, so the lanes would run behind their text. */
	:root[data-has-hero] .sl-link-card {
		background: color-mix(in srgb, var(--sl-color-bg) 82%, transparent);
	}

	@media (prefers-reduced-motion: no-preference) {
		.commit-backdrop::before,
		.commit-backdrop::after {
			animation: backdrop-breathe 9s ease-in-out infinite alternate;
		}
		.commit-backdrop::after {
			animation-delay: -4.5s;
		}

		:root[data-has-hero] .hero > img {
			animation:
				hero-rise 0.8s ease-out backwards,
				logo-pulse 3.5s ease-in-out 0.8s infinite alternate;
		}
		:root[data-has-hero] .hero h1,
		:root[data-has-hero] .hero .tagline,
		:root[data-has-hero] .hero .actions {
			animation: hero-rise 0.7s ease-out backwards;
		}
		:root[data-has-hero] .hero .tagline {
			animation-delay: 0.12s;
		}
		:root[data-has-hero] .hero .actions {
			animation-delay: 0.24s;
		}

		@supports (animation-timeline: view()) {
			:root[data-has-hero] .sl-markdown-content h2,
			:root[data-has-hero] .sl-markdown-content .card,
			:root[data-has-hero] .sl-link-card {
				animation: card-rise linear both;
				animation-timeline: view();
				animation-range: entry 0% entry 35%;
			}
		}
	}

	@keyframes backdrop-breathe {
		from {
			opacity: 0.55;
			transform: scale(0.94);
		}
		to {
			opacity: 1;
			transform: scale(1.06);
		}
	}
	@keyframes logo-pulse {
		from {
			filter: drop-shadow(0 0 1.75rem color-mix(in srgb, var(--tt-cyan) 22%, transparent));
		}
		to {
			filter: drop-shadow(0 0 4rem color-mix(in srgb, var(--tt-cyan) 60%, transparent));
		}
	}
	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(1rem);
		}
	}
	@keyframes card-rise {
		from {
			opacity: 0;
			transform: translateY(1.5rem);
		}
	}

	@media print {
		.commit-backdrop {
			display: none;
		}
	}
</style>
